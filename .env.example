# ---------------------------------------------------------------------------
# APT Stock Portal — environment variables
# Copy to .env.local for local development. NEVER commit .env.local.
# In Vercel: Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for creating logins, password resets and Zoho sync.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Zoho Books OAuth (api-console.zoho.in > Server-based Application) — server-only
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Organisation ID: Zoho Books > Settings > Organization Profile
ZOHO_ORGANIZATION_ID=
# Must exactly match the redirect URI registered in the Zoho API console, e.g.
# http://localhost:3000/api/zoho/callback (local) or https://<your-domain>/api/zoho/callback
ZOHO_REDIRECT_URI=
# Optional: a refresh token obtained elsewhere. Otherwise use "Connect Zoho Books" in the admin page.
ZOHO_REFRESH_TOKEN=
# Data centre. India (.in) defaults are used when blank. Confirm your account's region.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in

# Shared secret for the scheduled Zoho sync (Vercel Cron). Use a long random string.
CRON_SECRET=

# Optional: test accounts for `npm run test:remote` (read-only permission checks)
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=
VERIFY_OPERATOR_EMAIL=
VERIFY_OPERATOR_PASSWORD=
VERIFY_CUSTOMER_EMAIL=
VERIFY_CUSTOMER_PASSWORD=
